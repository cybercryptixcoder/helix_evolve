# Team Luminal settings, committed so the dashboard knows the endpoint right after cloning.
# The key goes in helix/.env (the dashboard's Connect panel writes it there; gitignored).
# helix/.env and real environment variables override these.
HELIX_PROVIDER=luminal
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_API_KEY=
HELIX_FLASH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
