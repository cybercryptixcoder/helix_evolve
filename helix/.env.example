# Copy this file to helix/.env and fill it in. helix/.env is gitignored, so keys never get committed.
# Then check the connection:  python -m helix.llm

# Luminal endpoint (OpenAI-style, ending in /v1) and key from the hackathon.
LUMINAL_BASE_URL=
LUMINAL_API_KEY=

# Model names exactly as Luminal lists them.
# Flash handles most calls; Pro (optional) handles every Nth call (see --pro-every).
HELIX_FLASH_MODEL=deepseek-v4.1-flash
HELIX_PRO_MODEL=

# Optional: extra JSON merged into every request, e.g. {"reasoning_effort": "low"}
LUMINAL_EXTRA_BODY=

# Alternative if your access comes through LLM Gateway instead of Luminal directly:
#   LUMINAL_BASE_URL=https://api.llmgateway.io/v1
#   HELIX_FLASH_MODEL=luminal/deepseek-v4.1-flash
