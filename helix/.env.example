# The dashboard (python -m helix.ui) writes helix/.env for you. To do it by hand instead,
# copy this file to helix/.env and fill it in. helix/.env is gitignored, so keys never get committed.
# Check the connection:  python -m helix.llm

# Which model server to use: luminal (default) or local
HELIX_PROVIDER=luminal

# Luminal endpoint (OpenAI-style, ending in /v1) and your key. See LUMINAL.md at the repo root.
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_API_KEY=
# Model names exactly as Luminal lists them. Flash handles every call; Pro (optional) every Nth call.
HELIX_FLASH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
HELIX_PRO_MODEL=
# Hidden thinking: "none" (the default) is the only setting that stops it; see LUMINAL.md.
HELIX_THINKING=none
# Optional: extra JSON merged into every request
LUMINAL_EXTRA_BODY=

# Alternative if your access comes through LLM Gateway instead of Luminal directly (never tested):
#   LUMINAL_BASE_URL=https://api.llmgateway.io/v1
#   HELIX_FLASH_MODEL=luminal/deepseek-v4.1-flash

# On-device option (HELIX_PROVIDER=local): any OpenAI-style local server.
#   Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# Optional: mirror every run into MongoDB (e.g. a free Atlas cluster). Needs: pip install pymongo
MONGODB_URI=
MONGODB_DB=helix
